	<subDataset name="detalle">
		<parameter name="C_Order_ID" class="java.math.BigDecimal">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[select
ol.c_order_id,
coalesce(p.value,'cargo') as codigo,
coalesce(p.name,u.name) nombre,
ol.description,
ol.priceentered,
ol.qtyentered,
ol.linenetamt,
ol.line / 10 as item,
ol.qtyordered,
ol.qtydelivered,
ol.qtyinvoiced,
cr.iso_code as moneda,
case when u.name='Unidad' then 'C/U' end as medida,
ol.description AS descripcion

from adempiere.c_orderline ol
left join adempiere.m_product p on (ol.m_product_id=p.m_product_id)
left join adempiere.c_charge c on (ol.c_charge_id=c.c_charge_id)
inner join adempiere.c_uom u on (ol.c_uom_id=u.c_uom_id)
left join adempiere.c_order o on (o.c_order_id = ol.c_order_id)
left join adempiere.c_currency cr on (cr.c_currency_id = o.c_currency_id)
where ol.c_order_id=$P{C_Order_ID}
order by ol.line]]>
		</queryString>
		<field name="c_order_id" class="java.math.BigDecimal"/>
		<field name="codigo" class="java.lang.String"/>
		<field name="nombre" class="java.lang.String"/>
		<field name="description" class="java.lang.String"/>
		<field name="priceentered" class="java.math.BigDecimal"/>
		<field name="qtyentered" class="java.math.BigDecimal"/>
		<field name="linenetamt" class="java.math.BigDecimal"/>
		<field name="item" class="java.math.BigDecimal"/>
		<field name="qtyordered" class="java.math.BigDecimal"/>
		<field name="qtydelivered" class="java.math.BigDecimal"/>
		<field name="qtyinvoiced" class="java.math.BigDecimal"/>
		<field name="moneda" class="java.lang.String"/>
		<field name="medida" class="java.lang.String"/>
		<field name="descripcion" class="java.lang.String"/>
	</subDataset>
	<parameter name="C_Order_ID" class="java.math.BigDecimal">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT o.c_order_id,
       o.issotrx,
       o.documentno,
       o.docstatus,
       o.c_bpartner_id,
       CONCAT(bp.value, '-', bp.digito) as rut,
       dt.printname AS documenttype,
       dt.documentnote AS documenttypenote,
       COALESCE(ubp.name, u.name) AS salesrep_name,
       o.dateordered,
       o.datepromised,
       bp.name,
       bp.name2,
       bpc.phone,
       NULLIF(bpc.name::text, bp.name::text) AS contactname,
       l.address1,
       bp.referenceno,
       o.description,
       o.poreference,
       pt.name AS paymentterm,
       o.totallines::numeric(12,2),
       o.grandtotal::numeric(12,2),
       wh.value AS almacen,
       (select sum(ta.taxamt) from adempiere.c_ordertax ta where ta.c_order_id=o.c_order_id) as impuesto,
       case when o.issotrx='Y' then 'Datos del Cliente' else 'Datos del Proveedor' end as cabecera,
       CASE WHEN o.c_doctype_id = 1000019 AND o.docstatus = 'CO' THEN 'Devolución de materiales' ELSE CASE WHEN o.c_doctype_id = 1000016  AND o.docstatus = 'CO' THEN 'Orden de compra' ELSE 'Borrador' END END as docname,
CASE WHEN o.docstatus = 'CO' THEN u2.description end as autoriza,
(select value from adempiere.a_asset where a_asset_id = (select max(mr.a_asset_id) from adempiere.c_orderline col join adempiere.m_requisitionline mrl on col.m_requisitionline_id=mrl.m_requisitionline_id join adempiere.m_requisition mr on mrl.m_requisition_id=mr.m_requisition_id where col.c_order_id=o.c_order_id)) as patente,
u3.description AS creador,
o.created AS inicio,
CASE WHEN o.docstatus= 'CO' THEN o.updated ELSE NULL END AS updated,
(SELECT u10.description
   FROM adempiere.ad_user u10
    JOIN adempiere.m_requisition r10 ON r10.updatedby = u10.ad_user_id
    JOIN adempiere.m_requisitionline rl10 ON rl10.m_requisition_id = r10.m_requisition_id
    JOIN adempiere.c_orderline ol10 ON ol10.m_requisitionline_id = rl10.m_requisitionline_id
   WHERE ol10.c_order_id = o.c_order_id
    AND r10.docstatus = 'CO' LIMIT 1) AS autorizado_sc
   FROM adempiere.c_order o
   JOIN adempiere.c_doctype dt ON o.c_doctypetarget_id = dt.c_doctype_id
   JOIN adempiere.m_warehouse wh ON o.m_warehouse_id = wh.m_warehouse_id
   JOIN adempiere.c_paymentterm pt ON o.c_paymentterm_id = pt.c_paymentterm_id
   JOIN adempiere.c_bpartner bp ON o.c_bpartner_id = bp.c_bpartner_id
   LEFT JOIN adempiere.c_greeting bpg ON bp.c_greeting_id = bpg.c_greeting_id
   JOIN adempiere.c_bpartner_location bpl ON o.c_bpartner_location_id = bpl.c_bpartner_location_id
   JOIN adempiere.c_location l ON bpl.c_location_id = l.c_location_id
   LEFT JOIN adempiere.ad_user bpc ON o.ad_user_id = bpc.ad_user_id
   LEFT JOIN adempiere.c_greeting bpcg ON bpc.c_greeting_id = bpcg.c_greeting_id
   JOIN adempiere.ad_orginfo oi ON o.ad_org_id = oi.ad_org_id
   JOIN adempiere.ad_clientinfo ci ON o.ad_client_id = ci.ad_client_id
   LEFT JOIN adempiere.ad_user u ON o.salesrep_id = u.ad_user_id
   LEFT JOIN adempiere.c_bpartner ubp ON u.c_bpartner_id = ubp.c_bpartner_id
   LEFT JOIN adempiere.ad_user u2 ON o.updatedby = u2.ad_user_id
   LEFT JOIN adempiere.ad_user u3 ON u3.ad_user_id = o.createdby


where o.c_order_id= $P{C_Order_ID}]]>
	</queryString>
	<field name="c_order_id" class="java.math.BigDecimal"/>
	<field name="issotrx" class="java.lang.String"/>
	<field name="documentno" class="java.lang.String"/>
	<field name="docstatus" class="java.lang.String"/>
	<field name="c_bpartner_id" class="java.math.BigDecimal"/>
	<field name="rut" class="java.lang.String"/>
